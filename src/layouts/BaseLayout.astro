---
import { siteConfig } from "../config/site";
import { homePath, tagsPath } from "../lib/routing";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  homeTheme?: boolean;
}

const {
  title = siteConfig.siteTitle,
  description = siteConfig.siteDescription,
  canonicalPath = Astro.url.pathname,
  homeTheme = false,
} = Astro.props;

const pageTitle =
  title === siteConfig.siteTitle ? title : `${title} | ${siteConfig.siteTitle}`;
const canonicalUrl = Astro.site
  ? new URL(canonicalPath, Astro.site).toString()
  : undefined;
const navigation = [
  { href: homePath(), label: "首页" },
  ...(homeTheme ? [
    { href: "#projects", label: "作品" },
    { href: "#writing", label: "文章" },
  ] : []),
  { href: tagsPath(), label: "标签" },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={homeTheme ? "#ffffff" : "#fafafa"} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={siteConfig.siteTitle} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" sizes="512x512" href={homePath() + "favicon.png"} />
    <link rel="shortcut icon" href={homePath() + "favicon.ico"} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  </head>
  <body class:list={["quiet-product-theme", { "home-theme": homeTheme }]}>
    <a class="skip-link" href="#main-content">跳至正文</a>
    <header class="site-header site-header--quiet-product">
      <div class="site-shell site-header__inner site-header__inner--quiet-product">
        <a class="site-brand site-brand--quiet-product" href={homePath()}>
          <span class="site-brand__name">{siteConfig.siteTitle}</span>
          <span class="site-brand__tagline">{homeTheme ? "/ Notes" : "Notes"}</span>
        </a>
        <nav class="site-nav site-nav--quiet-product" aria-label="主导航">
          {navigation.map((item) => (
            <a class="site-nav__link" href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1" class="site-main site-main--quiet-product">
      <div class="site-shell site-shell--quiet-product">
        <slot />
      </div>
    </main>
    <footer class="site-footer site-footer--quiet-product">
      <div class="site-shell site-footer__inner site-footer__inner--quiet-product">
        <p>© {new Date().getFullYear()}</p>
        {homeTheme && <a class="home-back-top" href="#home-title">回到顶部 <span aria-hidden="true">↑</span></a>}
      </div>
    </footer>
  </body>
</html>

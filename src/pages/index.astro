---
import { getCollection } from "astro:content";

import PostList from "../components/PostList.astro";
import { siteConfig } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedEntries } from "../lib/posts";
import { archivePath, homePath, withBase } from "../lib/routing";
import "../styles/home.css";

const posts = getPublishedEntries(await getCollection("posts"));
const rincodeUrl = "https://github.com/2568xt/RinCode";
---

<BaseLayout
  canonicalPath={homePath()}
  description="Rin 的个人主页。记录 AI 与 Agent 的学习、实践与思考，构建自然语言协作编码工具 RinCode。"
  homeTheme
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__content">
        <h1 id="home-title">{siteConfig.siteTitle}</h1>
        <p class="home-hero__statement">我在这里记录关于 AI 与 Agent 的学习、实践与思考。</p>
        <p class="home-hero__keywords">记忆 / 评测 / 工具调用 / 工作流</p>
        <a class="home-text-link" href="https://github.com/2568xt" target="_blank" rel="noopener noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="home-hero__visual">
        <div class="avatar-drag-layer">
          <div class="avatar-float-layer">
            <img
              src={withBase("images/rin-chrome-head-v1.png")}
              alt="Rin 的银色头像"
              width="380"
              height="380"
              loading="eager"
              decoding="async"
              class="avatar-image"
              draggable="false"
            />
            <canvas class="avatar-canvas" aria-hidden="true"></canvas>
          </div>
        </div>
      </div>
      <a class="home-hero__scroll-cue" href="#projects">向下探索 <span aria-hidden="true">↓</span></a>
    </section>

    <section id="projects" class="home-section home-projects" aria-labelledby="projects-title" tabindex="-1">
      <header class="home-section-label">
        <h2 id="projects-title">项目</h2>
        <span>Projects</span>
      </header>
      <article class="rincode-project" aria-labelledby="rincode-title">
        <div class="rincode-project__header">
          <img class="rincode-project__mark" src={withBase("images/rincode/mark.svg")} alt="" width="40" height="40" />
          <div>
            <h3 id="rincode-title"><a href={rincodeUrl} target="_blank" rel="noopener noreferrer">RinCode <span aria-hidden="true">↗</span></a></h3>
            <p>自然语言协作的编码 Agent</p>
          </div>
          <span class="rincode-project__type">开源项目</span>
        </div>
        <p class="rincode-project__description">在项目里读代码、改文件、运行测试。<br />从桌面到终端，把对话和执行放在一起。</p>
        <figure class="rincode-film">
          <video
            src={withBase("videos/rincode/promo-1080p.mp4")}
            poster={withBase("videos/rincode/poster.png")}
            width="1920"
            height="1080"
            controls
            playsinline
            preload="none"
            aria-label="RinCode 宣传片：从一句想法，到下一次提交。"
          >
            <a href={withBase("videos/rincode/promo-1080p.mp4")}>直接打开 RinCode 宣传片</a>
          </video>
          <figcaption>
            <span>宣传片 · 00:40</span>
            <button class="home-text-link rincode-film__preview" type="button" aria-label="查看 RinCode 桌面界面" aria-haspopup="dialog" data-preview-open>
              桌面界面 <span aria-hidden="true">↗</span>
            </button>
          </figcaption>
        </figure>
        <div class="rincode-project__footer">
          <span>macOS · Terminal</span>
          <div>
            <a class="home-text-link" href={rincodeUrl} target="_blank" rel="noopener noreferrer">源代码 <span aria-hidden="true">↗</span></a>
            <a class="home-text-link" href={`${rincodeUrl}#快速开始`} target="_blank" rel="noopener noreferrer">上手指南 <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </article>
    </section>

    <section id="writing" class="home-section home-writing" aria-labelledby="writing-title" tabindex="-1">
      <div class="home-section-label">
        <h2 id="writing-title">文章</h2>
        <span>Writing</span>
      </div>
      <div class="home-writing__content">
        <header class="home-writing__header">
          <p class="home-writing__count">{posts.length} 篇已发布</p>
          <a href={archivePath()} class="home-text-link">文章档案 <span aria-hidden="true">↗</span></a>
        </header>
        <PostList posts={posts} />
      </div>
    </section>

    <dialog class="rincode-lightbox" aria-labelledby="rincode-preview-title">
      <div class="rincode-lightbox__header">
        <h2 id="rincode-preview-title">RinCode <span>桌面界面 · 演示项目</span></h2>
        <form method="dialog"><button type="submit" aria-label="关闭预览">关闭 <span aria-hidden="true">×</span></button></form>
      </div>
      <img src={withBase("images/rincode/desktop.png")} alt="RinCode 桌面完整预览，展示项目会话树、对话内容、模型选择与任务输入区" width="1440" height="888" loading="lazy" />
    </dialog>

  </div>

  <script>
    const preview = document.querySelector<HTMLDialogElement>(".rincode-lightbox");
    document.querySelector<HTMLButtonElement>("[data-preview-open]")?.addEventListener("click", () => preview?.showModal());
    preview?.addEventListener("click", (event) => {
      if (event.target !== preview) return;
      const bounds = preview.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
        preview.close();
      }
    });
  </script>

  <script>
    import { initAvatarRipple } from "../lib/avatar-ripple";

    const hero = document.querySelector<HTMLElement>(".home-hero");
    const visual = document.querySelector<HTMLElement>(".home-hero__visual");
    const dragLayer = document.querySelector<HTMLElement>(".avatar-drag-layer");
    const floatLayer = document.querySelector<HTMLElement>(".avatar-float-layer");
    const canvas = document.querySelector<HTMLCanvasElement>(".avatar-canvas");
    const avatar = document.querySelector<HTMLImageElement>(".avatar-image");

    if (hero && visual && dragLayer && canvas && avatar) {
      const ripple = initAvatarRipple(canvas, avatar, visual, dragLayer);
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const events = new AbortController();
      let visible = true;
      let scrollFrame: number | null = null;

      const updateScroll = () => {
        scrollFrame = null;
        if (!visible && !reducedMotion.matches) return;
        const scroll = reducedMotion.matches ? 0 : Math.max(0, window.scrollY);
        const textDistance = window.innerWidth <= 760 ? 240 : 360;
        hero.style.setProperty("--hero-progress", Math.min(1, scroll / textDistance).toFixed(4));
        hero.style.setProperty("--avatar-progress", Math.min(1, scroll / 500).toFixed(4));
      };

      const scheduleScroll = () => {
        if (scrollFrame === null) scrollFrame = requestAnimationFrame(updateScroll);
      };

      const updateMotion = () => {
        if (floatLayer) {
          floatLayer.style.animationPlayState = visible && !reducedMotion.matches ? "running" : "paused";
        }
        scheduleScroll();
      };

      const observer = new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        ripple?.setHeroVisible(visible);
        updateMotion();
      });
      observer.observe(hero);
      window.addEventListener("scroll", scheduleScroll, { passive: true, signal: events.signal });
      window.addEventListener("resize", scheduleScroll, { passive: true, signal: events.signal });
      reducedMotion.addEventListener("change", updateMotion, { signal: events.signal });
      updateMotion();

      document.addEventListener("astro:before-swap", () => {
        events.abort();
        if (scrollFrame !== null) cancelAnimationFrame(scrollFrame);
        observer.disconnect();
        ripple?.destroy();
      }, { once: true });
    }
  </script>
</BaseLayout>
